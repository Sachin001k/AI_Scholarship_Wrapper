# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings → API) ---
# Public values: safe in the browser because every table has Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New "publishable" key (sb_publishable_...). The legacy anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Not used yet; needed later for Edge Functions / admin jobs.
# NEVER prefix with NEXT_PUBLIC_ and never commit it.
# SUPABASE_SECRET_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Rename once Tanisha picks the domain / brand.
NEXT_PUBLIC_SITE_NAME=Scholarship Wrapper
